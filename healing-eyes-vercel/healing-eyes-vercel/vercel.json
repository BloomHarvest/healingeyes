{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/foundation", "destination": "/foundation-course" },
    { "source": "/foundation-course", "destination": "/foundation-course" },
    { "source": "/academy", "destination": "/academy" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
